{
  "name": "@d20dao/studio",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "prepare:compiler": "node scripts/prepare-compiler.mjs",
    "predev": "npm run prepare:compiler",
    "dev": "vite --host 127.0.0.1 --port 5178 --strictPort",
