    "@types/prismjs": "1.26.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "6.1.1",
    "ethers": "6.17.0",
    "hardhat": "3.16.0",
    "solc": "0.8.28",
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "vitest": "5.0.1"
